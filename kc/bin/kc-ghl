#!/usr/bin/env python3
"""kc-ghl: one launcher for every KC GHL MCP lane.

Usage:
  kc-ghl --lane <lane> --caller <profile>          start the BusyBee MCP server for that lane
  kc-ghl --lane <lane> --caller <profile> --check  validate lane, caller, and secrets; start nothing
  kc-ghl --list                                    show lanes and allowed callers
  kc-ghl --add-subaccount <locationId> --vault-key <KEY> [--lane ghl_agency_admin] [--replace]
                                                   give the agency lane a sub-account's private
                                                   integration (already stored in the vault under KEY):
                                                   verifies the token reads that sub-account and
                                                   nothing else, backs up the registry, adds the entry

The lane registry (lanes.json) holds no secrets. Secrets come from the KC vault by
name at launch and only the lane's own secrets enter the server process.
--caller is attribution for the audit log, not authentication: every profile runs
as the same OS user.
"""
import argparse, json, os, re, shutil, subprocess, sys, time, urllib.error, urllib.request

REGISTRY = os.environ.get('KC_GHL_REGISTRY', '/home/aya/.local/share/kc-ghl/lanes.json')
WORKDIR = '/home/aya/.local/share/kc-ghl'  # no .env here; the server never reads a stray one
SECRET_HELPER = os.environ.get('KC_SECRET_BIN', '/home/aya/.local/bin/kc-secret')


def fail(msg, code=2):
    sys.stderr.write(f'kc-ghl: {msg}\n')
    sys.exit(code)


def load():
    try:
        with open(REGISTRY) as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        fail(f'cannot read lane registry: {type(e).__name__}')


ID20 = re.compile(r'[A-Za-z0-9]{20}')
KEYNAME = re.compile(r'[A-Z][A-Z0-9_]*')


RESERVED_PREFIXES = ('KC_GHL_', 'GHL_FIREBASE_')
RESERVED_NAMES = {'GHL_API_KEY', 'GHL_LOCATION_ID', 'GHL_USER_ID', 'GHL_COMPANY_ID', 'PATH', 'HOME'}
ALLOWED_KC_OVERRIDES = {'KC_GHL_AGENCY_PATHS'}  # data, not identity: lanes may extend the agency path list


def reserved(name):
    if name in ALLOWED_KC_OVERRIDES:
        return False
    return name in RESERVED_NAMES or name.startswith(RESERVED_PREFIXES)


def validate(reg):
    """Fail cleanly (exit 2, one line) on any malformed registry; never a traceback."""
    if not isinstance(reg, dict):
        fail('lane registry must be a JSON object')
    for k in ('server', 'token_cache_dir', 'audit_log'):
        if not isinstance(reg.get(k), str) or not reg[k].startswith('/'):
            fail(f'lane registry: {k} must be an absolute path')
    if not isinstance(reg.get('lanes'), dict) or not reg['lanes']:
        fail('lane registry: lanes must be a non-empty object')
    ce = reg.get('common_env', {})
    if not isinstance(ce, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in ce.items()):
        fail('lane registry: common_env must map names to strings')
    if any(reserved(k) for k in ce):
        fail('lane registry: common_env may not set launcher-controlled variables')
    for name, lane in reg['lanes'].items():
        where = f'lane {name}'
        if not isinstance(lane, dict):
            fail(f'{where} must be an object')
        if lane.get('pending'):
            continue
        for k in ('location_id', 'user_id', 'company_id'):
            if not isinstance(lane.get(k), str) or not ID20.fullmatch(lane[k]):
                fail(f'{where}: {k} must be a 20-character ID')
        if not isinstance(lane.get('credential_owner'), str) or not lane['credential_owner']:
            fail(f'{where}: credential_owner is required')
        if not isinstance(lane.get('pinned', True), bool):
            fail(f'{where}: pinned must be true or false')
        callers = lane.get('callers')
        if not isinstance(callers, list) or not callers or not all(isinstance(c, str) and c for c in callers):
            fail(f'{where}: callers must be a non-empty list of profile names')
        secrets = lane.get('secrets')
        if not isinstance(secrets, dict) or not secrets or not all(
                isinstance(k, str) and isinstance(v, str) and KEYNAME.fullmatch(v) for k, v in secrets.items()):
            fail(f'{where}: secrets must map env names to vault key names')
        if 'GHL_API_KEY' not in secrets:
            fail(f'{where}: secrets must include GHL_API_KEY')
        lt = lane.get('location_tokens', {})
        if not isinstance(lt, dict) or not all(isinstance(k, str) and ID20.fullmatch(k) and isinstance(v, str) and KEYNAME.fullmatch(v) for k, v in lt.items()):
            fail(f'{where}: location_tokens must map 20-character location IDs to vault key names')
        if lt and lane.get('pinned', True):
            fail(f'{where}: location_tokens is only for unpinned (agency) lanes')
        env = lane.get('env', {})
        if not isinstance(env, dict) or not all(isinstance(k, str) and (v is None or isinstance(v, (str, int))) for k, v in env.items()):
            fail(f'{where}: env must map names to strings')
        bad = sorted(k for k in env if reserved(k))
        if bad:
            fail(f"{where}: env may not set launcher-controlled variables ({', '.join(bad)})")


def secret(name):
    # stdin=DEVNULL: never let the helper touch the MCP stdio pipe
    r = subprocess.run([SECRET_HELPER, 'get', name], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    value = r.stdout.strip()
    if r.returncode != 0 or not value or '\n' in value:
        fail(f'vault secret {name} is missing or malformed')
    return value


def ghl_get_conclusive(token, path):
    """GET with retries for inconclusive answers (429, 5xx, network). Returns the final status."""
    status = 0
    for wait in (0, 3, 8, 15):
        time.sleep(wait)
        status, _ = ghl_get(token, path)
        if status not in (0, 429) and status < 500:
            return status
    return status


def ghl_get(token, path):
    req = urllib.request.Request(f'https://services.leadconnectorhq.com{path}', headers={
        'Authorization': f'Bearer {token}', 'Version': '2021-07-28', 'Accept': 'application/json',
        'User-Agent': 'kc-ghl/1.0 (+KC Hermes lanes)'})  # GHL's edge rejects the default urllib agent
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, json.loads(r.read() or b'{}')
    except urllib.error.HTTPError as e:
        return e.code, {}
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        return 0, {}


def add_subaccount(reg, lane_name, loc, key, replace=False):
    """Register one sub-account private integration on an unpinned lane. Variables only: no code change."""
    if not re.fullmatch(r'[A-Za-z0-9]{20}', loc or ''):
        fail('location ID must be 20 letters/digits')
    if not re.fullmatch(r'[A-Z][A-Z0-9_]{2,80}', key or ''):
        fail('--vault-key must be an ENV_STYLE vault key name')
    lane = reg.get('lanes', {}).get(lane_name)
    if lane is None:
        fail(f'unknown lane {lane_name}')
    if lane.get('pinned', True):
        fail(f'lane {lane_name} is pinned; sub-account tokens are only for the unpinned (agency) lane')
    token = secret(key)
    status, body = ghl_get(token, f'/locations/{loc}')
    name = (body.get('location') or {}).get('name', '')
    if status != 200:
        fail(f'token in {key} cannot read location {loc} (HTTP {status})')
    # Must read this sub-account's own data (an agency token can read the record but not contacts) ...
    s_own = ghl_get_conclusive(token, f'/contacts/?locationId={loc}&limit=1')
    if s_own != 200:
        fail(f'token in {key} cannot read contacts in {loc} (HTTP {s_own}); expected that sub-account\'s own private integration')
    # ... and nothing in any other sub-account.
    others = [l for l in [lane.get('location_id')] + list((lane.get('location_tokens') or {}).keys()) if l and l != loc]
    for other in dict.fromkeys(others):
        s2 = ghl_get_conclusive(token, f'/contacts/?locationId={other}&limit=1')
        if s2 == 200:
            fail(f'token in {key} can also read sub-account {other}; expected a sub-account-scoped private integration')
        if s2 not in (401, 403):
            fail(f'could not confirm {key} is denied in sub-account {other} (HTTP {s2}); try again later')
    current = lane.get('location_tokens') or {}
    if current.get(loc) == key:
        print(f'already registered | {loc} ({name}) -> {key}')
        return
    if loc in current and not replace:
        fail(f'{loc} is already registered with {current[loc]}; pass --replace to change it')
    os.makedirs(os.path.join(os.path.dirname(REGISTRY), 'backups'), mode=0o700, exist_ok=True)
    backup = os.path.join(os.path.dirname(REGISTRY), 'backups', f'{os.path.basename(REGISTRY)}.{time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())}')
    shutil.copy2(REGISTRY, backup)
    current[loc] = key
    lane['location_tokens'] = dict(sorted(current.items()))
    tmp = f'{REGISTRY}.{os.getpid()}.tmp'
    with open(tmp, 'w') as f:
        json.dump(reg, f, indent=2)
        f.write('\n')
    os.chmod(tmp, 0o600)
    os.replace(tmp, REGISTRY)
    print(f'added | lane {lane_name} | {loc} ({name}) -> {key} | {len(current)} sub-accounts | backup {backup}')
    print('restart the lane (or /reload-mcp in open sessions) to load it')


def main():
    ap = argparse.ArgumentParser(prog='kc-ghl')
    ap.add_argument('--lane')
    ap.add_argument('--caller')
    ap.add_argument('--check', action='store_true')
    ap.add_argument('--list', action='store_true')
    ap.add_argument('--add-subaccount', metavar='LOCATION_ID')
    ap.add_argument('--vault-key')
    ap.add_argument('--replace', action='store_true')
    a = ap.parse_args()
    reg = load()
    validate(reg)
    lanes = reg['lanes']

    if a.add_subaccount:
        add_subaccount(reg, a.lane or 'ghl_agency_admin', a.add_subaccount, a.vault_key, a.replace)
        return

    if a.list:
        for name, lane in lanes.items():
            state = 'PENDING' if lane.get('pending') else 'ready'
            print(f"{name:20} {state:8} {lane.get('account', '')} | callers: {', '.join(lane.get('callers') or [])}")
        return

    if not a.lane or not a.caller:
        fail('--lane and --caller are required')
    lane = lanes.get(a.lane)
    if lane is None:
        fail(f'unknown lane {a.lane}')
    if a.caller not in lane.get('callers', []):
        fail(f'caller {a.caller} is not approved for lane {a.lane}')
    if lane.get('pending'):
        fail(f"lane {a.lane} is not ready: {lane['pending']}")

    env = {k: os.environ[k] for k in ('PATH', 'HOME', 'LANG', 'LC_ALL', 'TMPDIR') if k in os.environ}
    env.update(reg.get('common_env', {}))
    for k, v in (lane.get('env') or {}).items():  # validated: never a launcher-controlled name
        if v is None or v == '':
            env.pop(k, None)
        else:
            env[k] = str(v)
    env.update({
        'GHL_LOCATION_ID': lane['location_id'],
        'GHL_USER_ID': lane['user_id'],
        'GHL_COMPANY_ID': lane['company_id'],
        'KC_GHL_LANE': a.lane,
        'KC_GHL_CALLER': a.caller,
        'KC_GHL_AUDIT_LOG': reg['audit_log'],
        'KC_GHL_TOKEN_CACHE_DIR': reg['token_cache_dir'],
        # Stable shared-cache identity: who owns the login and which vault key holds it.
        'KC_GHL_CREDENTIAL': f"{lane['credential_owner']}:{lane['secrets'].get('GHL_FIREBASE_REFRESH_TOKEN', 'none')}",
    })
    # Location lanes are pinned; an agency lane sets pinned: false and may target any sub-account.
    if lane.get('pinned', True):
        env['KC_GHL_PINNED_LOCATION'] = lane['location_id']
    for env_name, vault_name in lane['secrets'].items():
        env[env_name] = secret(vault_name)
    # Agency lane: one private integration per sub-account ({locationId: vault key}).
    loc_tokens = lane.get('location_tokens') or {}
    if loc_tokens:
        env['KC_GHL_LOCATION_TOKENS'] = json.dumps({loc: secret(key) for loc, key in loc_tokens.items()})

    node = shutil.which('node', path=env.get('PATH'))
    if not node:
        fail('node is not on PATH')
    if not os.path.isfile(reg['server']):
        fail('BusyBee server build is missing')

    if a.check:
        print(f"ok | lane {a.lane} | caller {a.caller} | account {lane.get('account', a.lane)} | {len(lane['secrets'])} secrets loaded"
              + (f" | {len(loc_tokens)} sub-account tokens" if loc_tokens else ''))
        return
    os.chdir(WORKDIR)
    os.execve(node, [node, reg['server']], env)


if __name__ == '__main__':
    main()
